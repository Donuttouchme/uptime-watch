# Copy to .env and fill in. .env is gitignored; this file is not.
# Passwords: letters and digits are safest. Characters like @ : / % must be
# URL-encoded (e.g. @ becomes %40), or they break the URL.
DATABASE_URL=postgresql+psycopg://uptime_watch:CHANGE_ME@localhost:5432/uptime_watch
TEST_DATABASE_URL=postgresql+psycopg://uptime_watch:CHANGE_ME@localhost:5432/uptime_watch_test

# Redis: database 0 for the app, 15 for the tests (the tests empty it).
REDIS_URL=redis://localhost:6379/0
TEST_REDIS_URL=redis://localhost:6379/15
# Optional, shown with their defaults:
# SCHEDULER_TICK_SECONDS=5
# CHECK_TIMEOUT_SECONDS=10